 /// A thin wrapper over the IOHID monitor client. Only the main run loop touches it.
 final class ALSReader {
-    struct Reading { let xyz: XYZ; let lux: Double; let cct: Double }
+    /// `diagnostics` layout (OpenDisplay experiment): raw channels 0–3, colour-space flag (0 undefined,
+    /// 1 XYZ), illuminance, calibration-blob length, then the blob's bytes. Field numbers are from
+    /// Apple's open-source IOHIDEventFieldDefs.h (IOHIDFamily-1787): ALS fields 1–4, 6 and 11; the
+    /// blob is vendor-defined fields 3 (length) and 4 (data) on the first child event.
+    struct Reading { let xyz: XYZ; let lux: Double; let cct: Double; var diagnostics: [Double] = [] }
 
     /// Every event that reaches the callback, ambient light or not (used by the Debug sensor check).
     var onAnyEvent: ((Int32) -> Void)?
@@ -84,7 +89,24 @@ final class ALSReader {
         // Field IDs are (event type << 16) | field index.
         let lux = Double(float(event, 0x000C_0000))
         let xyz = XYZ(x: double(event, 0x000C_0007), y: double(event, 0x000C_0008), z: double(event, 0x000C_0009))
-        onEvent?(Reading(xyz: xyz, lux: lux, cct: double(event, 0x000C_000A)))
+        var diagnostics = (1...4).map { double(event, 0x000C_0000 | Int32($0)) }
+        diagnostics.append(Double(api.getInteger?(event, 0x000C_0006) ?? -1))
+        diagnostics.append(double(event, 0x000C_000B))
+        diagnostics += calibrationBlob(event, api: api)
+        onEvent?(Reading(xyz: xyz, lux: lux, cct: double(event, 0x000C_000A), diagnostics: diagnostics))
+    }
+
+    /// `[length, byte0, byte1, …]`, or `[0]` when the event carries no child blob.
+    private func calibrationBlob(_ event: UnsafeMutableRawPointer, api: IOHIDAPI) -> [Double] {
+        // Get rule: the array is not retained for us.
+        guard let pointer = api.getChildren?(event) else { return [0] }
+        let children = Unmanaged<CFArray>.fromOpaque(pointer).takeUnretainedValue()
+        guard CFArrayGetCount(children) > 0,
+              let raw = CFArrayGetValueAtIndex(children, 0) else { return [0] }
+        let child = UnsafeMutableRawPointer(mutating: raw)
+        let length = api.getInteger?(child, 0x0001_0003) ?? 0
+        guard length > 0, length <= 512, let data = api.getData?(child, 0x0001_0004) else { return [Double(length)] }
+        return [Double(length)] + (0..<length).map { Double(data[$0]) }
     }
 }
 
