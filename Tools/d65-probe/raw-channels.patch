-    var threshold = 0.10
+    var threshold = 0.15
+    private var smoothed = 1.0
 
     var isStable: Bool {
         #if targetEnvironment(simulator)
@@ -63,7 +64,10 @@ final class StillnessMonitor: @unchecked Sendable {
             guard let self, let motion else { return }
             let r = motion.rotationRate, a = motion.userAcceleration
             let value = max(abs(r.x), abs(r.y), abs(r.z)) + max(abs(a.x), abs(a.y), abs(a.z)) * 2
-            self.lock.lock(); self.stable = value < self.threshold; self.lock.unlock()
+            // A hand holding the phone to an upright monitor trembles in short spikes; smooth over
